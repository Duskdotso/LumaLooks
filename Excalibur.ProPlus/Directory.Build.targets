<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<Target Name="CopyToPlugins" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)"
		      DestinationFiles="C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag\BepInEx\plugins\$(TargetFileName)" />

		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
		      DestinationFiles="C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag\BepInEx\plugins\$(TargetName).pdb"
		      Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

		<ItemGroup>
			<AllCsFiles Include="@(Compile)" />
		</ItemGroup>

		<Message Text="Total cs files: @(AllCsFiles->Count())" Importance="high" />
		<Message Text="Copied DLL and pdb to plugins" Importance="high" />
	</Target>
</Project>
